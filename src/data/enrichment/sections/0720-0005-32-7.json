  "blocks": [
    {
      "type": "citation",
      "text": "(720 ILCS 5/32-7) (from Ch. 38, par. 32-7)"
    },
    {
      "type": "heading",
      "text": "Sec. 32-7. Simulating legal process."
    },
    {
      "type": "subsection",
      "label": "(a)",
      "text": "(a) A person commits simulating legal process when he or she issues or delivers any document which he or she knows falsely purports to be or simulates any civil or criminal process."
    },
    {
      "type": "subsection",
      "label": "(b)",
      "text": "(b) Sentence. Simulating legal process is a Class B misdemeanor."
    },
    {
      "type": "source",
      "text": "(Source: P.A. 97-1108, eff. 1-1-13.)"
    }
