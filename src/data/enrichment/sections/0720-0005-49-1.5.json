    {
      "type": "heading",
      "text": "Sec. 49-1.5. Draft card mutilation."
    },
    {
      "type": "subsection",
      "label": "(a)",
      "text": "(a) A person commits draft card mutilation when he or she knowingly destroys or mutilates a valid registration certificate or any other valid certificate issued under the federal \"Military Selective Service Act of 1967\"."
    },
    {
      "type": "subsection",
      "label": "(b)",
      "text": "(b) Sentence. Draft card mutilation is a Class 4 felony."
    },
    {
      "type": "source",
      "text": "(Source: P.A. 97-1108, eff. 1-1-13.)"
    }
