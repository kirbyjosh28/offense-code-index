      "text": "Sec. 31-3. Obstructing service of process."
    },
    {
      "type": "paragraph",
      "text": "Whoever knowingly resists or obstructs the authorized service or execution of any civil or criminal process or order of any court commits a Class B misdemeanor."
    },
    {
      "type": "source",
      "text": "(Source: P.A. 77-2638.)"
