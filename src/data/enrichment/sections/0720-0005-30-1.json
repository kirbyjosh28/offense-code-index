  "headingText": "Sec. 30-1. Treason.",
  "blocks": [
    {
      "type": "citation",
      "text": "(720 ILCS 5/30-1) (from Ch. 38, par. 30-1)"
    },
    {
      "type": "heading",
      "text": "Sec. 30-1. Treason."
    },
    {
      "type": "subsection",
      "label": "(a)",
      "text": "(a) A person owing allegiance to this State commits treason when he or she knowingly:"
    },
    {
      "type": "subsection",
      "label": "(1)",
      "text": "(1) levies war against this State; or"
    },
    {
      "type": "subsection",
      "label": "(2)",
      "text": "(2) adheres to the enemies of this State, giving them aid or comfort. (b) No person may be convicted of treason except on the testimony of 2 witnesses to the same overt act, or on his confession in open court."
    },
    {
      "type": "subsection",
      "label": "(c)",
      "text": "(c) Sentence. Treason is a Class X felony."
    },
    {
      "type": "source",
      "text": "(Source: P.A. 103-51, eff. 1-1-24.)"
    }
  ],
