  "blocks": [
    {
      "type": "citation",
      "text": "(720 ILCS 5/31-8) (from Ch. 38, par. 31-8)"
    },
    {
      "type": "heading",
      "text": "Sec. 31-8. Refusing to aid an officer."
    },
    {
      "type": "paragraph",
      "text": "Whoever upon command refuses or knowingly fails reasonably to aid a person known by him to be a peace officer in:"
    },
    {
      "type": "subsection",
      "label": "(a)",
      "text": "(a) Apprehending a person whom the officer is authorized to apprehend; or"
    },
    {
      "type": "subsection",
      "label": "(b)",
      "text": "(b) Preventing the commission by another of any offense, commits a petty offense."
    },
    {
      "type": "source",
      "text": "(Source: P.A. 77-2638.)"
    }
  ],
  "sourceLine": "(Source: P.A. 77-2638.)",
