  "blocks": [
    {
      "type": "citation",
      "text": "(720 ILCS 5/32-1) (from Ch. 38, par. 32-1)"
    },
    {
      "type": "heading",
      "text": "Sec. 32-1. Compounding a crime."
    },
    {
      "type": "subsection",
      "label": "(a)",
      "text": "(a) A person commits compounding a crime when he or she knowingly receives or offers to another any consideration for a promise not to prosecute or aid in the prosecution of an offender."
    },
    {
      "type": "subsection",
      "label": "(b)",
      "text": "(b) Sentence. Compounding a crime is a petty offense."
    },
    {
      "type": "source",
      "text": "(Source: P.A. 97-1108, eff. 1-1-13.)"
    }
