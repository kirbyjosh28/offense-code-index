    {
      "type": "heading",
      "text": "Sec. 6-304. Permitting unauthorized person to drive."
    },
    {
      "type": "paragraph",
      "text": "No person shall cause, authorize or knowingly permit a motor vehicle owned by him or under his control to be driven upon any highway by any person who is not authorized hereunder or in violation of any of the provisions of this Act."
    },
    {
      "type": "source",
      "text": "(Source: P.A. 76-1586.)"
    }
