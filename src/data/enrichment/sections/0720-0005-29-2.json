      "text": "(720 ILCS 5/29-2) (from Ch. 38, par. 29-2)"
    },
    {
      "type": "heading",
      "text": "Sec. 29-2. Accepting a bribe."
    },
    {
      "type": "paragraph",
      "text": "Any person participating in, officiating or connected with any professional or amateur athletic contest, sporting event or exhibition who accepts or agrees to accept any money, bribe or other thing of value or advantage with the intent, understanding or agreement that he will not use his best efforts in connection with such contest, event or exhibition commits a Class 4 felony."
    },
    {
      "type": "source",
      "text": "(Source: P.A. 77-2638.)"
    }
  ],
