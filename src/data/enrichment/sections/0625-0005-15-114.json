  "blocks": [
    {
      "type": "citation",
      "text": "(625 ILCS 5/15-114) (from Ch. 95 1/2, par. 15-114)"
    },
    {
      "type": "heading",
      "text": "Sec. 15-114. Pushing of disabled vehicles."
    },
    {
      "type": "paragraph",
      "text": "It is unlawful under any circumstances for any vehicle to push any other vehicle on or along any highway outside an urban area in this State, except in an extreme emergency and then the vehicle shall not be pushed farther than is reasonably necessary to remove it from the roadway or from the immediate hazard that exists."
    },
    {
      "type": "source",
      "text": "(Source: P.A. 78-486.)"
    }
  ],
