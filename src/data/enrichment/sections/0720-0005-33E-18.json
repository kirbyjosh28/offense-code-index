  "headingText": "Sec. 33E-18. Unlawful stringing of bids.",
  "blocks": [
    {
      "type": "citation",
      "text": "(720 ILCS 5/33E-18)"
    },
    {
      "type": "heading",
      "text": "Sec. 33E-18. Unlawful stringing of bids."
    },
    {
      "type": "subsection",
      "label": "(a)",
      "text": "(a) A person commits unlawful stringing of bids when he or she, with the intent to evade the bidding requirements of any unit of local government or school district, knowingly strings or assists in stringing or attempts to string any contract or job order with the unit of local government or school district."
    },
    {
      "type": "subsection",
      "label": "(b)",
      "text": "(b) Sentence. Unlawful stringing of bids is a Class 4 felony."
    },
    {
      "type": "source",
      "text": "(Source: P.A. 97-1108, eff. 1-1-13; 98-756, eff. 7-16-14.)"
    }
  ],
