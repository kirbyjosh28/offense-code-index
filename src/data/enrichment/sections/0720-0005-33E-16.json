  "headingText": "Sec. 33E-16. Misapplication of funds.",
  "blocks": [
    {
      "type": "citation",
      "text": "(720 ILCS 5/33E-16)"
    },
    {
      "type": "heading",
      "text": "Sec. 33E-16. Misapplication of funds."
    },
    {
      "type": "subsection",
      "label": "(a)",
      "text": "(a) An officer, director, agent, or employee of, or affiliated in any capacity with any unit of local government or school district commits misapplication of funds when he or she knowingly misapplies any of the moneys, funds, or credits of the unit of local government or school district."
    },
    {
      "type": "subsection",
      "label": "(b)",
      "text": "(b) Sentence. Misapplication of funds is a Class 3 felony."
    },
    {
      "type": "source",
      "text": "(Source: P.A. 97-1108, eff. 1-1-13.)"
    }
