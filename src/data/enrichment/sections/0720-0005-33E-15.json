    {
      "type": "heading",
      "text": "Sec. 33E-15. False entries."
    },
    {
      "type": "subsection",
      "label": "(a)",
      "text": "(a) An officer, agent, or employee of, or anyone who is affiliated in any capacity with any unit of local government or school district commits false entries when he or she makes a false entry in any book, report, or statement of any unit of local government or school district with the intent to defraud the unit of local government or school district."
    },
    {
      "type": "subsection",
      "label": "(b)",
      "text": "(b) Sentence. False entries is a Class 3 felony."
    },
    {
      "type": "source",
      "text": "(Source: P.A. 97-1108, eff. 1-1-13.)"
    }
  ],
