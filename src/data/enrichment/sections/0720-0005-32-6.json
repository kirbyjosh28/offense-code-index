  "headingText": "Sec. 32-6. Performance of unauthorized acts.",
  "blocks": [
    {
      "type": "citation",
      "text": "(720 ILCS 5/32-6) (from Ch. 38, par. 32-6)"
    },
    {
      "type": "heading",
      "text": "Sec. 32-6. Performance of unauthorized acts."
    },
    {
      "type": "paragraph",
      "text": "A person who performs any of the following acts, knowing that his performance is not authorized by law, commits a Class 4 felony:"
    },
    {
      "type": "subsection",
      "label": "(a)",
      "text": "(a) Conducts a marriage ceremony; or"
    },
    {
      "type": "subsection",
      "label": "(b)",
      "text": "(b) Acknowledges the execution of any document which by law may be recorded; or"
    },
    {
      "type": "subsection",
      "label": "(c)",
      "text": "(c) Becomes a surety for any party in any civil or criminal proceeding, before any court or public officer authorized to accept such surety."
    },
    {
      "type": "source",
      "text": "(Source: P.A. 77-2638)"
    }
  ],
  "sourceLine": "(Source: P.A. 77-2638)",
