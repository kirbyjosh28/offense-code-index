      "type": "heading",
      "text": "Sec. 11-803. Starting parked vehicle."
    },
    {
      "type": "paragraph",
      "text": "No person shall start a vehicle which is stopped, standing, or parked unless and until such movement can be made with reasonable safety."
    },
    {
      "type": "source",
      "text": "(Source: P.A. 76-1586.)"
    }
