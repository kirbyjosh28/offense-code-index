      "type": "citation",
      "text": "(720 ILCS 5/21-2) (from Ch. 38, par. 21-2)"
    },
    {
      "type": "heading",
      "text": "Sec. 21-2. Criminal trespass to vehicles."
    },
    {
      "type": "subsection",
      "label": "(a)",
      "text": "(a) A person commits criminal trespass to vehicles when he or she knowingly and without authority enters any part of or operates any vehicle, aircraft, watercraft or snowmobile."
    },
    {
      "type": "subsection",
      "label": "(b)",
      "text": "(b) Sentence. Criminal trespass to vehicles is a Class A misdemeanor."
    },
    {
      "type": "source",
      "text": "(Source: P.A. 97-1108, eff. 1-1-13.)"
    }
