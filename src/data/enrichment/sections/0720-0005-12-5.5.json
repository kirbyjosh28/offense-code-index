    {
      "type": "heading",
      "text": "Sec. 12-5.5. Common carrier recklessness."
    },
    {
      "type": "subsection",
      "label": "(a)",
      "text": "(a) A person commits common carrier recklessness when he or she, having personal management or control of or over a public conveyance used for the common carriage of persons, recklessly endangers the safety of others."
    },
    {
      "type": "subsection",
      "label": "(b)",
      "text": "(b) Sentence. Common carrier recklessness is a Class 4 felony."
    },
    {
      "type": "source",
      "text": "(Source: P.A. 96-1551, eff. 7-1-11.)"
    }
