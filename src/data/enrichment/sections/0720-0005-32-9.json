  "blocks": [
    {
      "type": "citation",
      "text": "(720 ILCS 5/32-9) (from Ch. 38, par. 32-9)"
    },
    {
      "type": "heading",
      "text": "Sec. 32-9. Tampering with public notice."
    },
    {
      "type": "subsection",
      "label": "(a)",
      "text": "(a) A person commits tampering with public notice when he or she knowingly and without lawful authority alters, destroys, defaces, removes or conceals any public notice, posted according to law, during the time for which the notice was to remain posted."
    },
    {
      "type": "subsection",
      "label": "(b)",
      "text": "(b) Sentence. Tampering with public notice is a petty offense."
    },
    {
      "type": "source",
      "text": "(Source: P.A. 97-1108, eff. 1-1-13.)"
    }
