      "type": "heading",
      "text": "Sec. 10-3. Unlawful restraint."
    },
    {
      "type": "subsection",
      "label": "(a)",
      "text": "(a) A person commits the offense of unlawful restraint when he or she knowingly without legal authority detains another."
    },
    {
      "type": "subsection",
      "label": "(b)",
      "text": "(b) Sentence. Unlawful restraint is a Class 4 felony."
    },
