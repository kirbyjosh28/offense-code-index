      "text": "Sec. 12-3. Battery."
    },
    {
      "type": "subsection",
      "label": "(a)",
      "text": "(a) A person commits battery if he or she knowingly without legal justification by any means (1) causes bodily harm to an individual or (2) makes physical contact of an insulting or provoking nature with an individual."
    },
    {
      "type": "subsection",
      "label": "(b)",
      "text": "(b) Sentence."
    },
    {
      "type": "paragraph",
      "text": "Battery is a Class A misdemeanor."
    },
